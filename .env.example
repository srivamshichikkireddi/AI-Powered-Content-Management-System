# Environment Configuration for AICMS
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (PostgreSQL + pgvector)
POSTGRES_USER=aicms_user
POSTGRES_PASSWORD=aicms_password
POSTGRES_DB=aicms_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aicms_user:aicms_password@db:5432/aicms_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
STORAGE_DIR=backend/storage/uploads
MAX_UPLOAD_SIZE_BYTES=20971520

# AI / ML Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDER=default
SIMULATE_MODEL_FAILURE=0
SIMULATE_PARSER_FAILURE=0

# Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
